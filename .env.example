# .env.example documents the required variables and can be committed.


# .env contains your real local values and is not committed.


# Kafka
KAFKA_SERVER=localhost:9092
KAFKA_TOPIC=raw-field-readings
BRONZE_BATCH_SIZE=100
KAFKA_CONSUMER_GROUP=bronze-v2-consumer
WEATHER_KAFKA_TOPIC=raw-weather-readings
WEATHER_CONSUMER_GROUP=weather-bronze-v2-consumer

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=smart-farming-v2
MINIO_SECURE=false


SOURCE_SYSTEM=smart_farming_crop_yield_csv
SOURCE_TYPE=batch_file_simulated_as_stream
SOURCE_FORMAT=csv
SOURCE_SCHEMA_VERSION=source-1.0.0

WEATHER_SOURCE_SYSTEM=farm_weather_station
WEATHER_SOURCE_TYPE=streaming_sensor
WEATHER_SOURCE_FORMAT=json
WEATHER_SOURCE_SCHEMA_VERSION=weather-source-1.0.0



